{
  "name": "orchestra-ai-code",
  "displayName": "Orchestra AI Code",
  "description": "Local AI coding assistant (Orchestra) for VS Code and Cursor — chat, tools, dry-run apply, bundled core.",
  "version": "0.1.2",
  "publisher": "Screamgxne",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/GreyKxtx/Orchestra#readme",
  "bugs": {
    "url": "https://github.com/GreyKxtx/Orchestra/issues"
  },
  "keywords": [
    "ai",
    "coding assistant",
    "llm",
    "agent",
    "local",
    "orchestra",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GreyKxtx/Orchestra"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "orchestra.openChat",
        "title": "Orchestra: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "orchestra.pingCore",
        "title": "Orchestra: Ping Core"
      },
      {
        "command": "orchestra.openSettings",
        "title": "Orchestra: Settings"
      },
      {
        "command": "orchestra.showOutput",
        "title": "Orchestra: Show Output"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "orchestra.openChat",
          "when": "true"
        },
        {
          "command": "orchestra.openSettings",
          "when": "true"
        },
        {
          "command": "orchestra.pingCore",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "orchestra.openChat",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "orchestra.openChat",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "orchestra",
          "title": "Orchestra",
          "icon": "images/orchestra.svg"
        }
      ]
    },
    "views": {
      "orchestra": [
        {
          "type": "webview",
          "id": "orchestra.chatSidebar",
          "name": "Chat",
          "icon": "images/orchestra.svg"
        }
      ]
    },
    "configuration": {
      "title": "Orchestra",
      "properties": {
        "orchestra.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Full path to orchestra(.exe). Empty = bundled bin/<platform>-<arch>/ in the VSIX, then workspace/repo fallbacks."
        },
        "orchestra.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Project root passed to orchestra core. Empty = first workspace folder (or folder picker if none)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "bundle:webview": "node scripts/bundle-chat.mjs && node scripts/bundle-settings.mjs",
    "compile": "npm run bundle:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/**/*.test.js",
    "bundle:core": "node scripts/bundle-core.mjs",
    "bundle:core:all": "node scripts/bundle-core.mjs --all",
    "bundle:core:target": "node scripts/bundle-core.mjs --target",
    "package": "npm run compile && vsce package --no-dependencies",
    "package:marketplace": "npm run bundle:core:all && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "shiki": "^4.4.2",
    "typescript": "^5.3.3"
  }
}
